---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SectionReveal from '../components/SectionReveal.astro';
import heroImg from '../assets/images/book-herophoto.JPG';

const eventTypes = [
  "Sunday Service",
  "Youth Night / Camp",
  "Conference",
  "Leadership Event",
  "School Assembly",
  "Athletic / FCA Event",
  "Other"
];

const speakingFocus = [
  "Spiritual growth / deeper faith",
  "Leadership & conviction",
  "Identity & purpose",
  "Overcoming adversity",
  "Athlete / team culture",
  "Open / led as needed"
];

const budgetRanges = [
  "Under $1,000",
  "$1,000 - $2,500",
  "$2,500 - $5,000",
  "$5,000+",
  "Not sure yet"
];

const SITE_URL = 'https://juliandismute.com';
const pageDescription =
  "Book Julian Dismute to speak at your church, youth event, conference, leadership gathering, or athletic event. Submit a speaking request and we'll be in touch soon.";

const bookingSchema = [
  {
    '@type': 'ContactPage',
    '@id': `${SITE_URL}/booking#page`,
    url: `${SITE_URL}/booking`,
    name: 'Book Julian Dismute',
    description: pageDescription,
    isPartOf: { '@id': `${SITE_URL}/#website` },
    about: { '@id': `${SITE_URL}/#julian` },
    breadcrumb: { '@id': `${SITE_URL}/booking#breadcrumb` },
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${SITE_URL}/booking#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
      { '@type': 'ListItem', position: 2, name: 'Book Julian', item: `${SITE_URL}/booking` },
    ],
  },
];
---

<BaseLayout
  title="Book Julian — Speaking Request"
  description={pageDescription}
  schema={bookingSchema}
>
  <Nav dark />

  <!-- ═══════════════ PAGE HERO ═══════════════ -->
  <section class="relative min-h-[50vh] flex items-end pt-28 bg-black overflow-hidden">
    <div class="absolute inset-0">
      <Image
        src={heroImg}
        alt="Julian Dismute speaking"
        class="w-full h-full object-cover opacity-30 grayscale"
        widths={[800, 1280, 1920]}
        sizes="100vw"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black via-black/60 to-transparent"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 md:px-12 pb-16 md:pb-24 w-full">
      <SectionReveal>
        <p class="text-brand-gold text-xs tracking-[0.3em] uppercase font-bold mb-4">Speaking Request</p>
        <h1 class="text-5xl md:text-8xl font-display uppercase tracking-tight text-white leading-[0.85] mb-6">
          Invite <br class="hidden md:block" />
          <span class="text-brand-gold">Julian.</span>
        </h1>
      </SectionReveal>
      <SectionReveal delay={200}>
        <p class="text-lg text-zinc-400 font-light max-w-xl">
          Thanks for thinking of Julian for your event. Fill out a few details below so we can get a feel for what you're planning and how Julian can best serve your people.
        </p>
      </SectionReveal>
    </div>
  </section>

  <!-- ═══════════════ BOOKING FORM ═══════════════ -->
  <section class="py-24 md:py-32 px-6 md:px-12 max-w-4xl mx-auto">
    <SectionReveal>
      <div class="mb-16 md:mb-20 pb-12 border-b border-zinc-200">
        <p class="text-brand-gold text-xs tracking-[0.3em] uppercase font-bold mb-4">Get in Touch</p>
        <h2 class="text-3xl md:text-5xl font-display uppercase tracking-tight mb-6 leading-tight">
          Reach out or <span class="text-brand-gold">book Julian</span> to speak.
        </h2>
        <p class="text-lg text-zinc-600 font-light max-w-2xl leading-relaxed">
          Whether you'd like to connect with Julian directly or invite him to speak at your event, fill out the form below and we'll be in touch. Prefer email? Reach us at
          <a href="mailto:contact@juliandismute.com" class="text-black underline decoration-brand-gold underline-offset-4 hover:text-brand-gold transition-colors">contact@juliandismute.com</a>.
        </p>
      </div>
    </SectionReveal>

    <form id="booking-form" action="https://formspree.io/f/mjglnoeb" method="POST" class="space-y-16">

      <!-- About You -->
      <div>
        <SectionReveal>
          <h2 class="text-3xl md:text-4xl font-display uppercase tracking-tight mb-2">About You</h2>
          <div class="w-12 h-1 bg-brand-gold mb-8"></div>
        </SectionReveal>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <SectionReveal delay={50}>
            <div>
              <label class="block text-xs tracking-[0.2em] uppercase font-bold text-zinc-500 mb-2">Your Name *</label>
              <input type="text" name="name" required class="w-full bg-transparent border-b-2 border-zinc-300 py-3 text-lg font-light focus:border-brand-gold focus:outline-none transition-colors placeholder-zinc-400" placeholder="Full name" />
            </div>
          </SectionReveal>
          <SectionReveal delay={100}>
            <div>
              <label class="block text-xs tracking-[0.2em] uppercase font-bold text-zinc-500 mb-2">Church / Organization *</label>
              <input type="text" name="organization" required class="w-full bg-transparent border-b-2 border-zinc-300 py-3 text-lg font-light focus:border-brand-gold focus:outline-none transition-colors placeholder-zinc-400" placeholder="Organization name" />
            </div>
          </SectionReveal>
          <SectionReveal delay={150}>
            <div>
              <label class="block text-xs tracking-[0.2em] uppercase font-bold text-zinc-500 mb-2">Your Role</label>
              <input type="text" name="role" class="w-full bg-transparent border-b-2 border-zinc-300 py-3 text-lg font-light focus:border-brand-gold focus:outline-none transition-colors placeholder-zinc-400" placeholder="Pastor, Leader, Coach, etc." />
            </div>
          </SectionReveal>
          <SectionReveal delay={200}>
            <div>
              <label class="block text-xs tracking-[0.2em] uppercase font-bold text-zinc-500 mb-2">Email *</label>
              <input type="email" name="email" required class="w-full bg-transparent border-b-2 border-zinc-300 py-3 text-lg font-light focus:border-brand-gold focus:outline-none transition-colors placeholder-zinc-400" placeholder="you@church.org" />
            </div>
          </SectionReveal>
          <SectionReveal delay={250}>
            <div>
              <label class="block text-xs tracking-[0.2em] uppercase font-bold text-zinc-500 mb-2">Phone Number</label>
              <input type="tel" name="phone" class="w-full bg-transparent border-b-2 border-zinc-300 py-3 text-lg font-light focus:border-brand-gold focus:outline-none transition-colors placeholder-zinc-400" placeholder="(555) 000-0000" />
            </div>
          </SectionReveal>
        </div>
      </div>

      <!-- About the Event -->
      <div>
        <SectionReveal>
          <h2 class="text-3xl md:text-4xl font-display uppercase tracking-tight mb-2">About the Event</h2>
          <div class="w-12 h-1 bg-brand-gold mb-8"></div>
        </SectionReveal>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <SectionReveal delay={50}>
            <div>
              <label class="block text-xs tracking-[0.2em] uppercase font-bold text-zinc-500 mb-2">Event Name *</label>
              <input type="text" name="event_name" required class="w-full bg-transparent border-b-2 border-zinc-300 py-3 text-lg font-light focus:border-brand-gold focus:outline-none transition-colors placeholder-zinc-400" placeholder="Event name" />
            </div>
          </SectionReveal>
          <SectionReveal delay={100}>
            <div>
              <label class="block text-xs tracking-[0.2em] uppercase font-bold text-zinc-500 mb-2">Type of Event *</label>
              <select name="event_type" required class="w-full bg-transparent border-b-2 border-zinc-300 py-3 text-lg font-light focus:border-brand-gold focus:outline-none transition-colors text-zinc-900">
                <option value="" disabled selected>Select event type</option>
                {eventTypes.map((type) => (
                  <option value={type}>{type}</option>
                ))}
              </select>
            </div>
          </SectionReveal>
          <SectionReveal delay={150}>
            <div>
              <label class="block text-xs tracking-[0.2em] uppercase font-bold text-zinc-500 mb-2">Event Date(s) *</label>
              <input type="text" name="event_date" required class="w-full bg-transparent border-b-2 border-zinc-300 py-3 text-lg font-light focus:border-brand-gold focus:outline-none transition-colors placeholder-zinc-400" placeholder="Date or date range" />
            </div>
          </SectionReveal>
          <SectionReveal delay={200}>
            <div>
              <label class="block text-xs tracking-[0.2em] uppercase font-bold text-zinc-500 mb-2">Location (City, State)</label>
              <input type="text" name="location" class="w-full bg-transparent border-b-2 border-zinc-300 py-3 text-lg font-light focus:border-brand-gold focus:outline-none transition-colors placeholder-zinc-400" placeholder="City, State" />
            </div>
          </SectionReveal>
          <SectionReveal delay={250} class="md:col-span-2">
            <div>
              <label class="block text-xs tracking-[0.2em] uppercase font-bold text-zinc-500 mb-2">Who will be in the room?</label>
              <input type="text" name="audience" class="w-full bg-transparent border-b-2 border-zinc-300 py-3 text-lg font-light focus:border-brand-gold focus:outline-none transition-colors placeholder-zinc-400" placeholder="Students, adults, leaders, athletes, etc." />
            </div>
          </SectionReveal>
        </div>
      </div>

      <!-- Heart of the Event -->
      <div>
        <SectionReveal>
          <h2 class="text-3xl md:text-4xl font-display uppercase tracking-tight mb-2">Heart of the Event</h2>
          <div class="w-12 h-1 bg-brand-gold mb-8"></div>
        </SectionReveal>

        <div class="space-y-6">
          <SectionReveal delay={50}>
            <div>
              <label class="block text-xs tracking-[0.2em] uppercase font-bold text-zinc-500 mb-2">What is your heart or goal for this event?</label>
              <textarea name="event_goal" rows="4" class="w-full bg-transparent border-2 border-zinc-300 p-4 text-lg font-light focus:border-brand-gold focus:outline-none transition-colors resize-none placeholder-zinc-400" placeholder="Tell us about your vision..."></textarea>
            </div>
          </SectionReveal>
          <SectionReveal delay={100}>
            <div>
              <label class="block text-xs tracking-[0.2em] uppercase font-bold text-zinc-500 mb-2">What do you feel your people need most right now?</label>
              <textarea name="people_need" rows="4" class="w-full bg-transparent border-2 border-zinc-300 p-4 text-lg font-light focus:border-brand-gold focus:outline-none transition-colors resize-none placeholder-zinc-400" placeholder="What is God placing on your heart?"></textarea>
            </div>
          </SectionReveal>
        </div>
      </div>

      <!-- Logistics & Budget -->
      <div>
        <SectionReveal>
          <h2 class="text-3xl md:text-4xl font-display uppercase tracking-tight mb-2">Logistics &amp; Budget</h2>
          <div class="w-12 h-1 bg-brand-gold mb-8"></div>
        </SectionReveal>

        <div class="space-y-8">
          <SectionReveal delay={50}>
            <div>
              <label class="block text-xs tracking-[0.2em] uppercase font-bold text-zinc-500 mb-4">Speaking Focus</label>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                {speakingFocus.map((focus) => (
                  <label class="flex items-center gap-3 p-4 border border-zinc-200 hover:border-brand-gold transition-colors cursor-pointer group">
                    <input type="checkbox" name="speaking_focus" value={focus} class="w-4 h-4 accent-brand-gold" />
                    <span class="text-sm font-light group-hover:text-brand-gold transition-colors">{focus}</span>
                  </label>
                ))}
              </div>
            </div>
          </SectionReveal>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <SectionReveal delay={100}>
              <div>
                <label class="block text-xs tracking-[0.2em] uppercase font-bold text-zinc-500 mb-2">Will travel be required? Nearest airport?</label>
                <input type="text" name="travel" class="w-full bg-transparent border-b-2 border-zinc-300 py-3 text-lg font-light focus:border-brand-gold focus:outline-none transition-colors placeholder-zinc-400" placeholder="Yes / No — nearest airport" />
              </div>
            </SectionReveal>
            <SectionReveal delay={150}>
              <div>
                <label class="block text-xs tracking-[0.2em] uppercase font-bold text-zinc-500 mb-2">Will travel and lodging be provided?</label>
                <select name="lodging" class="w-full bg-transparent border-b-2 border-zinc-300 py-3 text-lg font-light focus:border-brand-gold focus:outline-none transition-colors">
                  <option value="" disabled selected>Select</option>
                  <option value="yes">Yes</option>
                  <option value="no">No</option>
                  <option value="partial">Partial</option>
                  <option value="tbd">To be discussed</option>
                </select>
              </div>
            </SectionReveal>
          </div>

          <SectionReveal delay={200}>
            <div>
              <label class="block text-xs tracking-[0.2em] uppercase font-bold text-zinc-500 mb-4">Budget Range</label>
              <div class="flex flex-wrap gap-3">
                {budgetRanges.map((range) => (
                  <label class="flex items-center gap-2 px-5 py-3 border border-zinc-200 hover:border-brand-gold transition-colors cursor-pointer group">
                    <input type="radio" name="budget" value={range} class="accent-brand-gold" />
                    <span class="text-sm font-light group-hover:text-brand-gold transition-colors">{range}</span>
                  </label>
                ))}
              </div>
            </div>
          </SectionReveal>
        </div>
      </div>

      <!-- Submit -->
      <SectionReveal>
        <div class="pt-8 border-t border-zinc-200">
          <button id="booking-submit" type="submit" class="w-full md:w-auto px-16 py-5 bg-black text-white font-bold tracking-[0.2em] uppercase hover:bg-brand-gold transition-colors duration-300 text-lg disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-black">
            Submit Request
          </button>
          <p id="booking-error" class="hidden text-sm text-red-600 mt-4 font-light" role="alert"></p>
          <p class="text-sm text-zinc-400 mt-4 font-light">
            Every invitation is prayed over and taken seriously. We'll be in touch soon.
          </p>
        </div>
      </SectionReveal>
    </form>
  </section>

  <!-- ═══════════════ CONFIRMATION MESSAGE (hidden by default) ═══════════════ -->
  <div id="form-success" class="hidden fixed inset-0 bg-black/90 z-50 flex items-center justify-center p-6">
    <div class="bg-white max-w-lg w-full p-12 text-center">
      <div class="w-16 h-16 bg-brand-gold mx-auto mb-6 flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
      </div>
      <h3 class="text-3xl font-display uppercase tracking-tight mb-4">Request Received</h3>
      <p class="text-zinc-600 font-light mb-8">
        Thank you for reaching out. Every invitation is prayed over and taken seriously. We'll be in touch with you soon.
      </p>
      <a href="/" class="inline-block px-8 py-3 bg-black text-white font-bold tracking-[0.15em] uppercase hover:bg-brand-gold transition-colors text-sm">
        Back to Home
      </a>
    </div>
  </div>

  <Footer />
</BaseLayout>

<script>
  const form = document.getElementById('booking-form') as HTMLFormElement | null;
  const success = document.getElementById('form-success');
  const submitBtn = document.getElementById('booking-submit') as HTMLButtonElement | null;
  const errorEl = document.getElementById('booking-error');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form) return;

    const originalLabel = submitBtn?.textContent ?? 'Submit Request';
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';
    }
    if (errorEl) {
      errorEl.classList.add('hidden');
      errorEl.textContent = '';
    }

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });

      if (response.ok) {
        form.reset();
        success?.classList.remove('hidden');
      } else {
        const data = await response.json().catch(() => null);
        const message =
          data?.errors?.map((err: { message?: string }) => err.message).filter(Boolean).join(', ') ||
          "Something went wrong sending your request. Please try again, or email contact@juliandismute.com directly.";
        if (errorEl) {
          errorEl.textContent = message;
          errorEl.classList.remove('hidden');
        }
      }
    } catch {
      if (errorEl) {
        errorEl.textContent = "Network error. Please check your connection and try again.";
        errorEl.classList.remove('hidden');
      }
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = originalLabel;
      }
    }
  });
</script>
