---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SectionReveal from '../components/SectionReveal.astro';

const SITE_URL = 'https://juliandismute.com';
const pageDescription =
  "Privacy Policy for Julian Dismute — how we collect, use, and protect information submitted through the website and booking form.";

const lastUpdated = "May 14, 2026";

const privacySchema = [
  {
    '@type': 'WebPage',
    '@id': `${SITE_URL}/privacy#page`,
    url: `${SITE_URL}/privacy`,
    name: 'Privacy Policy',
    description: pageDescription,
    isPartOf: { '@id': `${SITE_URL}/#website` },
    breadcrumb: { '@id': `${SITE_URL}/privacy#breadcrumb` },
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${SITE_URL}/privacy#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
      { '@type': 'ListItem', position: 2, name: 'Privacy Policy', item: `${SITE_URL}/privacy` },
    ],
  },
];
---

<BaseLayout
  title="Privacy Policy — Julian Dismute"
  description={pageDescription}
  schema={privacySchema}
>
  <Nav dark />

  <!-- ═══════════════ PAGE HERO ═══════════════ -->
  <section class="relative pt-40 pb-16 md:pt-48 md:pb-24 px-6 md:px-12 bg-black text-white overflow-hidden">
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none opacity-[0.04] overflow-hidden">
      <span class="text-[12rem] md:text-[20rem] font-display text-white whitespace-nowrap leading-none">PRIVACY</span>
    </div>
    <div class="relative z-10 max-w-4xl mx-auto">
      <SectionReveal>
        <p class="text-brand-gold text-xs tracking-[0.3em] uppercase font-bold mb-4">Legal</p>
        <h1 class="text-5xl md:text-7xl font-display uppercase tracking-tight leading-[0.9] mb-6">
          Privacy <span class="text-brand-gold">Policy</span>
        </h1>
        <p class="text-sm tracking-[0.2em] uppercase text-zinc-500">Last updated: {lastUpdated}</p>
      </SectionReveal>
    </div>
  </section>

  <!-- ═══════════════ CONTENT ═══════════════ -->
  <section class="py-20 md:py-28 px-6 md:px-12">
    <article class="max-w-3xl mx-auto legal-prose">
      <SectionReveal>
        <p>
          This Privacy Policy describes how Julian Dismute Ministries ("we," "us," or "our")
          collects, uses, and shares information when you visit
          <a href="/">juliandismute.com</a> (the "Site") or submit a speaking request through
          the Site. By using the Site, you agree to the practices described below. If you do
          not agree, please do not use the Site.
        </p>
      </SectionReveal>

      <SectionReveal>
        <h2>1. Information We Collect</h2>
        <p>We collect two general categories of information:</p>
        <h3>Information You Provide</h3>
        <p>
          When you complete the speaking request form on the <a href="/booking">Booking</a> page,
          you may voluntarily provide: your name, organization, role, email address, phone number,
          event details (name, type, date, location, audience), the heart and goals of your event,
          travel and lodging logistics, and budget range. You may also email or message us directly
          using the contact details or social links published on the Site.
        </p>
        <h3>Information Collected Automatically</h3>
        <p>
          When you visit the Site, certain information may be collected automatically by our
          hosting provider and any analytics tools we may use, including: your IP address,
          browser type and version, device type, operating system, referring URL, pages viewed,
          and date and time of access. This information is used to operate, secure, and improve
          the Site.
        </p>
      </SectionReveal>

      <SectionReveal>
        <h2>2. How We Use Information</h2>
        <p>We use the information we collect to:</p>
        <ul>
          <li>Respond to speaking requests and other inquiries you send to us.</li>
          <li>Coordinate logistics for events Julian is invited to participate in.</li>
          <li>Operate, maintain, secure, and improve the Site.</li>
          <li>Send occasional ministry or event updates if you have asked to receive them.</li>
          <li>Comply with our legal obligations and enforce our <a href="/terms">Terms of Use</a>.</li>
        </ul>
        <p>
          We do not sell your personal information, and we do not share it with third parties for
          their own marketing purposes.
        </p>
      </SectionReveal>

      <SectionReveal>
        <h2>3. Cookies and Similar Technologies</h2>
        <p>
          The Site may use cookies, pixels, and similar technologies to make the Site function
          properly, remember your preferences, and understand how visitors interact with the
          Site. You can control cookies through your browser settings; disabling them may affect
          some Site features.
        </p>
      </SectionReveal>

      <SectionReveal>
        <h2>4. Third-Party Services</h2>
        <p>
          The Site may load content or embeds from third parties (such as YouTube videos,
          Instagram, TikTok, Facebook, and font providers). When you interact with that content,
          those third parties may collect information about your visit under their own privacy
          policies. We are not responsible for the practices of third-party services, and we
          encourage you to review their policies directly.
        </p>
      </SectionReveal>

      <SectionReveal>
        <h2>5. How We Share Information</h2>
        <p>We may share information only as follows:</p>
        <ul>
          <li>
            With service providers who help us operate the Site or respond to requests (for
            example, hosting providers, form processors, and email services). These providers
            are permitted to use the information only to perform services for us.
          </li>
          <li>
            When required by law, subpoena, court order, or other legal process, or to protect
            our rights, safety, or property.
          </li>
          <li>
            In connection with a merger, acquisition, or transfer of all or part of our ministry
            assets, in which case information may be transferred to the successor.
          </li>
        </ul>
      </SectionReveal>

      <SectionReveal>
        <h2>6. Data Retention</h2>
        <p>
          We retain information for as long as it is necessary to fulfill the purposes outlined
          in this Policy, to comply with our legal obligations, resolve disputes, and enforce
          our agreements. You may ask us to delete information you submitted at any time by
          contacting us using the details below.
        </p>
      </SectionReveal>

      <SectionReveal>
        <h2>7. Your Rights and Choices</h2>
        <p>
          Depending on where you live, you may have certain rights under applicable data
          protection laws, including the right to access, correct, delete, or restrict the use
          of your personal information, and the right to object to or withdraw consent for
          certain processing. To exercise any of these rights, please contact us using the
          information in Section 11. We will respond consistent with applicable law.
        </p>
      </SectionReveal>

      <SectionReveal>
        <h2>8. Children's Privacy</h2>
        <p>
          The Site is not directed to children under 13, and we do not knowingly collect
          personal information from children under 13. If you believe a child has provided us
          with personal information, please contact us so we can delete it.
        </p>
      </SectionReveal>

      <SectionReveal>
        <h2>9. Security</h2>
        <p>
          We take reasonable steps to protect the information we collect. However, no method of
          transmission over the Internet or electronic storage is 100% secure, and we cannot
          guarantee absolute security.
        </p>
      </SectionReveal>

      <SectionReveal>
        <h2>10. Changes to This Policy</h2>
        <p>
          We may update this Privacy Policy from time to time. When we do, we will revise the
          "Last updated" date at the top of this page. Material changes will be communicated by
          posting the updated Policy on the Site. Your continued use of the Site after the
          changes take effect constitutes acceptance of the updated Policy.
        </p>
      </SectionReveal>

      <SectionReveal>
        <h2>11. Contact</h2>
        <p>
          Questions or requests regarding this Privacy Policy can be sent through the
          <a href="/booking">contact form</a> on this Site.
        </p>
      </SectionReveal>
    </article>
  </section>

  <Footer />
</BaseLayout>
