---
import { getImage } from 'astro:assets';
import img1 from '../assets/images/0M4A9206.JPG';
import img2 from '../assets/images/C14A3117.JPG';
import img3 from '../assets/images/DSC_0629.JPG';
import img4 from '../assets/images/DSC_0740.JPG';
import img5 from '../assets/images/DSC_8353.JPG';
import img6 from '../assets/images/IMG_1920.JPG';
import img7 from '../assets/images/IMG_8820.JPG';
import img8 from '../assets/images/IMG_19.JPG';
import img9 from '../assets/images/DSC_7859.jpg';
import img10 from '../assets/images/IMG_4449.JPG';

const sources = [img1, img2, img3, img4, img5, img6, img7, img8, img9, img10];
const optimized = await Promise.all(
  sources.map((src) => getImage({ src, format: 'webp', width: 800, quality: 75 }))
);
const HERO_IMAGES = optimized.map((o) => o.src);
const COLORS = ['bg-brand-gold', 'bg-zinc-900', 'bg-black', 'bg-zinc-800'];
---

<div class="absolute inset-0 z-0" id="hero-mosaic">
  <div class="absolute inset-0 grid grid-cols-4 md:grid-cols-8 grid-rows-8 md:grid-rows-4 gap-0 opacity-60" id="mosaic-grid">
    {Array.from({ length: 32 }).map((_, i) => (
      <div class="mosaic-cell w-full h-full relative overflow-hidden bg-black" data-index={i}></div>
    ))}
  </div>

  <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,transparent_10%,black_85%)]"></div>
  <div class="absolute inset-0 bg-gradient-to-t from-black via-black/30 to-black/10"></div>
</div>

<script define:vars={{ HERO_IMAGES, COLORS }}>
  function initMosaic() {
    const root = document.getElementById('hero-mosaic');
    if (!root) return;
    const cells = root.querySelectorAll('.mosaic-cell');
    if (!cells.length) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isMobile = window.matchMedia('(max-width: 768px)').matches;

    const imageCells = [];

    cells.forEach((cell, i) => {
      const isImage = Math.random() > 0.4;
      if (isImage) {
        const img = document.createElement('img');
        img.src = HERO_IMAGES[i % HERO_IMAGES.length];
        img.alt = '';
        img.className = 'absolute inset-0 w-full h-full object-cover grayscale opacity-60';
        img.loading = 'eager';
        img.decoding = 'async';
        cell.appendChild(img);
        imageCells.push(cell);
      } else {
        cell.classList.add(COLORS[i % COLORS.length]);
      }
    });

    if (reducedMotion || imageCells.length === 0) return;

    const interval = isMobile ? 4000 : 1000;
    let nextSrcIndex = Math.floor(Math.random() * HERO_IMAGES.length);
    let timer = null;

    const tick = () => {
      if (document.visibilityState !== 'visible') return;
      const cell = imageCells[Math.floor(Math.random() * imageCells.length)];
      const img = cell.querySelector('img');
      if (!img) return;
      const newSrc = HERO_IMAGES[nextSrcIndex++ % HERO_IMAGES.length];
      if (img.src.endsWith(newSrc)) return;
      cell.style.opacity = '0';
      setTimeout(() => {
        img.src = newSrc;
        cell.style.opacity = '1';
      }, 350);
    };

    const start = () => {
      if (timer === null) timer = window.setInterval(tick, interval);
    };
    const stop = () => {
      if (timer !== null) {
        clearInterval(timer);
        timer = null;
      }
    };

    const io = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) start();
        else stop();
      }
    }, { threshold: 0 });
    io.observe(root);

    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState !== 'visible') stop();
    });
  }

  if ('requestIdleCallback' in window) {
    requestIdleCallback(initMosaic, { timeout: 1000 });
  } else {
    setTimeout(initMosaic, 100);
  }
</script>

<style>
  .mosaic-cell {
    transition: opacity 0.35s ease-in-out;
  }
</style>
